extends SceneTree
## Measure exported corrective anchors with live skeleton/morph values. The
## measurements file is generated by reading the GLB, not by the sculpt script.
var failures=[]
func _initialize():call_deferred("run")
func check(ok:bool,label:String):
 if not ok and label not in failures:failures.append(label)
func vector(a)->Vector3:return Vector3(a[0],a[1],a[2])
func run():
 var stage=Node3D.new();stage.set_meta("alina_revision",true);root.add_child(stage)
 var actor=Node3D.new();stage.add_child(actor)
 var skin=DemoHumanSkin.new();actor.add_child(skin);skin.setup("Алина",Color.WHITE)
 var guitar=load("res://scripts/guitar_quality.gd").build(skin)
 var body=skin.find_children("Human","MeshInstance3D",true,false)[0]
 var data=JSON.parse_string(FileAccess.get_file_as_string("res://assets/characters/studies/ANATOMY_09_MEASUREMENTS.json"))
 check(FileAccess.get_sha256("res://assets/characters/studies/AlinaAnatomy09.glb")==data.source_sha256,"Measurement anchors belong to the loaded geometry")
 check(body.get_meta("anatomy_revision",0)==9 and skin.uses_anatomy,"The anatomical overlay actually loaded")
 check(skin.skeleton.get_bone_count()==67,"The preserved gameplay skeleton is intact")
 check(body.mesh.get_blend_shape_count()==7,"Body has the preserved channels plus two elbow correctives")
 var head=skin.find_children("AlinaRevisionHead","MeshInstance3D",true,false)[0]
 check(head.mesh.get_blend_shape_count()==63,"All facial expression channels remain available")
 var arrays=body.mesh.surface_get_arrays(0);var vertices=arrays[Mesh.ARRAY_VERTEX];var bones=arrays[Mesh.ARRAY_BONES];var weights=arrays[Mesh.ARRAY_WEIGHTS]
 var stride=weights.size()/vertices.size();check(stride==8,"Auxiliary bone weights retain the eight-weight format")
 var probes=[];var maximum_mapping_error=0.0
 for raw in data.probes:
  var p=vector(raw.position);var idx=vertices.find(p)
  if idx<0:
   var distance=INF
   for i in range(vertices.size()):
    var d=vertices[i].distance_squared_to(p)
    if d<distance:distance=d;idx=i
   maximum_mapping_error=maxf(maximum_mapping_error,sqrt(distance))
  var shape=-1
  for i in range(body.mesh.get_blend_shape_count()):
   if body.mesh.get_blend_shape_name(i)==raw.shape:shape=i
  check(shape>=0,"Both exported corrective channels exist at runtime")
  probes.append({"vertex":idx,"delta":vector(raw.delta),"shape":shape,"region":raw.region,"side":"_l" if str(raw.shape).ends_with("_l") else "_r"})
 check(maximum_mapping_error<.00001,"Exported anchors match actual engine vertices within 10 micrometres")
 var maximum_delta=0.0;var inner_delta=0.0;var outer_delta=0.0;var low=[1.0,1.0];var high=[0.0,0.0];var visited=0;var facial_peak=0.0
 for entry in [["guitar",120],["idle",90],["walk",90],["eat",60],["guitar",120]]:
  for frame in range(entry[1]):
   skin.tick(1./60,entry[0]=="walk",1.4 if entry[0]=="walk" else 0,entry[0],guitar,Vector3.ZERO)
   if frame%15!=0:continue
   var poses=[]
   for bone in range(skin.skeleton.get_bone_count()):poses.append(skin.skeleton.get_bone_global_pose(bone))
   for probe in probes:
    var value=body.get_blend_shape_value(probe.shape);var i=0 if probe.side=="_l" else 1
    low[i]=minf(low[i],value);high[i]=maxf(high[i],value)
    var base=Vector3.ZERO;var corrected=Vector3.ZERO
    for j in range(stride):
     var slot=probe.vertex*stride+j;var weight=weights[slot]
     if weight<=0:continue
     var bind=bones[slot];var bone=skin.indices[str(body.skin.get_bind_name(bind))];var matrix=poses[bone]*body.skin.get_bind_pose(bind)
     base+=(matrix*vertices[probe.vertex])*weight
     corrected+=(matrix*(vertices[probe.vertex]+probe.delta*value))*weight
    var delta=corrected-base;maximum_delta=maxf(maximum_delta,delta.length())
    var radial=(base-skin.global_pose("lowerarm"+probe.side).origin).normalized()
    if probe.region=="inner":inner_delta=minf(inner_delta,delta.dot(radial))
    else:outer_delta=maxf(outer_delta,delta.dot(radial))
    check(corrected.is_finite(),"Corrected elbow surface remains finite during action changes")
    visited+=1
   for channel in range(head.mesh.get_blend_shape_count()):
    if head.mesh.get_blend_shape_name(channel)=="jawOpen":facial_peak=maxf(facial_peak,head.get_blend_shape_value(channel))
 check(visited>100,"Corrected surfaces were measured over multiple actions")
 check(maximum_delta>.0003 and maximum_delta<.003,"Correctives produce a restrained nonzero surface deformation")
 check(inner_delta<-.00015 and outer_delta>.00015,"Inner elbow compresses while the posterior landmark retains volume")
 check(low[0]<.2 and low[1]<.2 and high[0]>.5 and high[1]>.5,"Both elbows adapt to extension and flexion instead of staying permanently sculpted")
 check(facial_peak>.02,"The preserved face still responds during eating")
 var report={"status":"PASS" if failures.is_empty() else "FAIL","failures":failures,"probe_samples":visited,"maximum_mapping_error_m":maximum_mapping_error,"maximum_corrective_displacement_m":maximum_delta,"inner_radial_change_m":inner_delta,"outer_radial_change_m":outer_delta,"minimum_corrective_weights":low,"maximum_corrective_weights":high,"jaw_expression_peak":facial_peak,"limitation":"Selected elbow anchors and exported integrity; no certification of whole-body anatomy or full surface contact."}
 print(JSON.stringify(report,"  "))
 var path=OS.get_environment("SHASHLIK_ANATOMY_REPORT")
 if not path.is_empty():FileAccess.open(path,FileAccess.WRITE).store_string(JSON.stringify(report,"  "))
 print("ANATOMY_DEFORMATION_09_",report.status)
 quit(0 if failures.is_empty() else 1)
